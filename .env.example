DATABASE_URL="file:./dev.db"

# Set to 1 to run without DingTalk credentials.
DINGTALK_MOCK=1

# DingTalk OAuth / OpenAPI settings.
DINGTALK_CLIENT_ID=""
DINGTALK_CLIENT_SECRET=""
DINGTALK_REDIRECT_URI="http://localhost:3000/api/auth/dingtalk/callback"
DINGTALK_OAUTH_AUTHORIZE_URL="https://login.dingtalk.com/oauth2/auth"
DINGTALK_API_BASE_URL="https://api.dingtalk.com"
